{
  "name": "delijn-realtime-android",
  "version": "1.0.0",
  "private": true,
  "description": "De Lijn 实时 — 单文件网页的 Android WebView 壳（Capacitor）",
  "type": "module",
  "scripts": {
    "sync:www": "node scripts/sync-www.mjs",
    "cap:sync": "node scripts/sync-www.mjs && cap sync android",
    "build:apk": "node scripts/sync-www.mjs && cap sync android && cd android && gradlew.bat assembleDebug",
    "install:apk": "node scripts/install-apk.mjs",
    "sync:ios": "node scripts/sync-www.mjs && cap copy ios",
    "build:ipa": "node scripts/build-ipa.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10"
  }
}
